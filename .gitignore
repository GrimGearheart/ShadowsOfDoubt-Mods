# Only the released mods, their shared code and the build tools are published.
# Everything else in this folder (decompiled game code, saved copies of the official docs,
# experiments and debug tools) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/RELEASING.md

!/CodeMods/
/CodeMods/*
!/CodeMods/ScrollThrottle/
!/CodeMods/DetectiveSquint/
!/CodeMods/Mantle/
!/CodeMods/Prone/
!/CodeMods/DetectiveLicense/
!/CodeMods/SanitationDepartment/
!/CodeMods/CityPlanner/
!/CodeMods/Proprietor/
!/CodeMods/SitAnywhere/
!/CodeMods/Shared/

!/Cities/
/Cities/*
!/Cities/MarginCity/

!/tools/
/tools/*
!/tools/package_thunderstore.py
!/tools/make_icon.py

# Build output and packaged zips
bin/
obj/
dist/
*.user
.vs/
__pycache__/
